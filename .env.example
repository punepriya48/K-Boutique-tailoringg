# Server Port
PORT=5000

# MongoDB Atlas Connection String
# Replace with your actual MongoDB Atlas URI (e.g. mongodb+srv://<username>:<password>@cluster0.mongodb.net/priyas_boutique)
MONGODB_URI=mongodb://127.0.0.1:27017/priyas_boutique

# JWT Secret Key for Session Authentication
JWT_SECRET=priyas_boutique_jwt_secret_key_2026_safe_hash

# CORS Allowed Origin (For production deployment)
# Set to your Vercel URL in production e.g. https://boutique-tailoring-d7tk.vercel.app
CLIENT_URL=http://localhost:5173
